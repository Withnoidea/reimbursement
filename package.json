{
  "name": "reimbursement-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node scripts/prepare-pdf-assets.mjs && node scripts/prepare-mail-deps.mjs && node scripts/prepare-updater-deps.mjs",
    "start": "node scripts/start-desktop.mjs",
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "prepare:runtime": "node scripts/prepare-python-runtime.mjs",
    "build:web": "node scripts/prepare-pdf-assets.mjs && node scripts/prepare-mail-deps.mjs && node scripts/prepare-updater-deps.mjs && vite build",
    "build": "npm run build:web && npm run prepare:runtime && node scripts/package-win-folder.mjs",
    "package:installer": "npm run build:web && npm run prepare:runtime && electron-builder --win nsis",
    "package:win-folder": "npm run build:web && npm run prepare:runtime && node scripts/package-win-folder.mjs",
    "release": "npm run package:installer -- --publish always",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron-updater": "^6.8.9",
    "idb": "^8.0.3",
    "imapflow": "^1.4.7",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.9.14",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.2",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.local.reimbursement",
    "productName": "报销单据管理",
    "directories": {
      "output": "dist-electron"
    },
    "publish": {
      "provider": "github",
      "owner": "Withnoidea",
      "repo": "reimbursement"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "icon.ico",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!_fixtures/**",
          "!_old_parse_pdf.py"
        ]
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "报销单据管理",
      "artifactName": "Reimbursement-${version}-Setup.${ext}"
    }
  }
}
